[
  {
    "id": "abandoned_car",
    "title": "Abandoned sedan",
    "text": "A sedan sits sideways across the lane, trunk ajar, driver's door open. Nothing moves inside. Probably.",
    "weight": 3,
    "choices": [
      {
        "text": "Search the trunk.",
        "outcomes": [
          {
            "weight": 3,
            "text": "Jumper cables, a tire iron, a bag of scrap. You take what's useful.",
            "effects": [
              { "type": "giveItem", "itemId": "scrap_metal", "qty": 2 },
              { "type": "giveItem", "itemId": "rubber_tube", "qty": 1 },
              { "type": "time", "minutes": 10 }
            ]
          },
          {
            "weight": 1,
            "text": "The car alarm shrieks the moment you touch it. You run before anything answers.",
            "effects": [
              { "type": "time", "minutes": 20 },
              { "type": "needs", "thirst": -5 },
              { "type": "damage", "hp": 4 }
            ]
          }
        ]
      },
      { "text": "Keep moving.", "outcomes": [{ "text": "Not worth the risk. You leave it.", "effects": [] }] }
    ]
  },
  {
    "id": "survivor_need",
    "title": "A man in the doorway",
    "text": "A thin man with a split lip waves you over from a doorway. \"Water. Please. I haven't had any in two days.\"",
    "weight": 2,
    "modes": ["foot"],
    "choices": [
      {
        "text": "Give him a bottle of water.",
        "if": [{ "type": "hasItem", "itemId": "water_bottle" }],
        "outcomes": [
          {
            "text": "He drinks half of it in one go and tells you the Westside pharmacy still has a back room nobody's opened. Word gets back to the camp.",
            "effects": [
              { "type": "takeItem", "itemId": "water_bottle" },
              { "type": "reputation", "delta": 4 },
              { "type": "xp", "amount": 20 },
              { "type": "unlockNode", "nodeId": "westside_mall" }
            ]
          }
        ]
      },
      {
        "text": "Give him dirty water. It's all you can spare.",
        "if": [{ "type": "hasItem", "itemId": "dirty_water" }],
        "outcomes": [
          {
            "text": "He looks at it for a long time, then drinks it anyway. \"Thanks,\" he says, and means it.",
            "effects": [
              { "type": "takeItem", "itemId": "dirty_water" },
              { "type": "reputation", "delta": 2 },
              { "type": "xp", "amount": 10 }
            ]
          }
        ]
      },
      { "text": "\"Sorry.\" Walk on.", "outcomes": [{ "text": "You don't look back.", "effects": [] }] }
    ]
  },
  {
    "id": "horde_crossing",
    "title": "The dead crossing",
    "text": "A slow river of the dead shuffles across the intersection ahead. Dozens. They haven't noticed you yet.",
    "weight": 2,
    "choices": [
      {
        "text": "Hide and wait it out.",
        "outcomes": [
          {
            "text": "An hour behind a dumpster. Your legs cramp. They pass.",
            "effects": [{ "type": "time", "minutes": 60 }]
          }
        ]
      },
      {
        "text": "Take the long way around.",
        "outcomes": [
          {
            "text": "Three blocks out of your way, but nobody bites you.",
            "effects": [
              { "type": "time", "minutes": 30 },
              { "type": "needs", "hunger": -3, "thirst": -5 }
            ]
          }
        ]
      },
      {
        "text": "Run for a gap.",
        "outcomes": [
          {
            "weight": 3,
            "text": "You slip through a gap in the crowd with your heart in your throat.",
            "effects": [{ "type": "xp", "amount": 15 }]
          },
          {
            "weight": 2,
            "text": "A hand catches your sleeve and nails rake your arm before you tear free.",
            "effects": [{ "type": "damage", "hp": 12 }]
          }
        ]
      }
    ]
  },
  {
    "id": "supply_drop",
    "title": "Supply drop",
    "text": "A pallet with a torn parachute hangs from a streetlight, ten feet up. Military markings.",
    "weight": 1,
    "choices": [
      {
        "text": "Climb for it.",
        "outcomes": [
          {
            "weight": 3,
            "text": "You get it down. Ration packs and water. Someone, somewhere, still cares.",
            "effects": [
              { "type": "giveItem", "itemId": "mre", "qty": 1 },
              { "type": "giveItem", "itemId": "water_bottle", "qty": 2 },
              { "type": "time", "minutes": 15 }
            ]
          },
          {
            "weight": 1,
            "text": "The pole bends. You fall hard, but grab one bottle on the way down.",
            "effects": [
              { "type": "damage", "hp": 8 },
              { "type": "giveItem", "itemId": "water_bottle", "qty": 1 }
            ]
          }
        ]
      },
      { "text": "Leave it. Drops draw crowds.", "outcomes": [{ "text": "Probably smart.", "effects": [] }] }
    ]
  },
  {
    "id": "tollmen_scouts",
    "title": "Men in hi-vis vests",
    "text": "Three men in orange safety vests and hunting rifles step out from behind a bus. \"Toll road, friend.\" One of them grins. \"Two cans and you keep walking.\"",
    "weight": 1,
    "if": [{ "type": "day", "min": 24 }],
    "choices": [
      {
        "text": "Pay them two cans of beans.",
        "if": [{ "type": "hasItem", "itemId": "canned_beans", "qty": 2 }],
        "outcomes": [
          {
            "text": "\"Pleasure.\" They wave you through. You notice the patches: a bridge, crossed out. The Tollmen.",
            "effects": [
              { "type": "takeItem", "itemId": "canned_beans", "qty": 2 },
              { "type": "setFlag", "key": "met_tollmen", "value": true }
            ]
          }
        ]
      },
      {
        "text": "Back off and go around.",
        "outcomes": [
          {
            "text": "They laugh as you leave. It costs you forty minutes.",
            "effects": [
              { "type": "time", "minutes": 40 },
              { "type": "setFlag", "key": "met_tollmen", "value": true }
            ]
          }
        ]
      },
      {
        "text": "Bluff: \"Ruth Okafor sends her regards.\"",
        "if": [{ "type": "reputation", "min": 20 }],
        "outcomes": [
          {
            "text": "The grin fades. \"Firehouse lady. Fine. Go.\" Good to know her name carries weight.",
            "effects": [
              { "type": "setFlag", "key": "met_tollmen", "value": true },
              { "type": "xp", "amount": 20 }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "road_blocked",
    "title": "Wrecks across the road",
    "text": "A pile-up blocks both lanes. A gap between a van and a guardrail might fit the ambulance.",
    "weight": 2,
    "modes": ["vehicle"],
    "choices": [
      {
        "text": "Push through the gap.",
        "outcomes": [
          {
            "weight": 2,
            "text": "Metal screams, mirrors go, but you're through.",
            "effects": [{ "type": "fuel", "liters": -1.5 }]
          },
          {
            "weight": 1,
            "text": "You wedge the ambulance and have to rock it free. Something big turns toward the noise.",
            "effects": [
              { "type": "fuel", "liters": -2.5 },
              { "type": "time", "minutes": 15 }
            ]
          }
        ]
      },
      {
        "text": "Detour around.",
        "outcomes": [
          {
            "text": "Ten extra minutes of side streets.",
            "effects": [
              { "type": "time", "minutes": 10 },
              { "type": "fuel", "liters": -1 }
            ]
          }
        ]
      }
    ]
  }
]
