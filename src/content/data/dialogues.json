              }
            ],
            "effects": [
              {
                "type": "takeItem",
                "itemId": "cat:drink",
                "qty": 3
              },
              {
                "type": "completeQuest",
                "questId": "kitchen_duty",
                "outcome": "water"
              },
              {
                "type": "stamp",
                "key": "kitchen_last"
              }
            ],
            "next": "thanks"
          },
          {
            "text": "Read the duty roster.",
            "effects": [
              {
                "type": "note",
                "noteId": "note_camp_roster"
              }
            ],
            "next": "board"
          },
          {
            "text": "Leave it.",
            "next": null
          }
        ]
      },
      "signed": {
        "text": "You add your name under a dozen others. The crate is by the mess tables.",
        "speaker": "Bounty board",
        "next": "board"
      },
      "thanks": {
        "text": "Somebody eats tonight because of you.",
        "speaker": "Bounty board"
      }
    }
  }
]
