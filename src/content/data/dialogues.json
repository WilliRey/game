                "qty": 3
              },
              {
                "type": "completeQuest",
                "questId": "kitchen_duty",
                "outcome": "food"
              },
              {
                "type": "stamp",
                "key": "kitchen_last"
              }
            ],
            "next": "thanks"
          },
          {
            "text": "Leave 3 drinks.",
            "if": [
              {
                "type": "quest",
