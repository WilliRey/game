            "target": "antibiotics",
            "text": "Get antibiotics from the Westside pharmacy"
          }
        ],
        "onEnter": [
          {
            "type": "unlockNode",
            "nodeId": "westside_mall"
          }
        ]
      },
      {
        "id": "deliver",
        "text": "Bring them to Doc Ama.",
        "objectives": [
          {
            "id": "give",
            "type": "deliver",
            "target": "antibiotics",
            "text": "Bring the antibiotics to Doc Ama",
            "npcId": "doc_ama",
            "consume": true
          }
        ]
      }
    ],
    "outcomes": {},
    "rewards": [
      {
        "type": "unlockTrader",
        "traderId": "doc"
      },
      {
        "type": "unlockRecipe",
        "recipeId": "first_aid_kit"
      },
      {
        "type": "reputation",
        "delta": 10
      },
      {
        "type": "xp",
        "amount": 120
      },
      {
        "type": "giveItem",
        "itemId": "first_aid_kit",
        "qty": 1
      }
    ]
  },
