[
  {
    "id": "prologue",
    "name": "Empty Cupboards",
    "type": "main",
    "description": "Day 23. The food ran out this morning. Find something to eat, find a weapon, and find other people.",
    "stages": [
      {
        "id": "kitchen",
        "text": "The cupboards are bare. Check them anyway.",
        "objectives": [
          {
            "id": "search",
            "type": "interact",
            "target": "mc_sam_cabinet",
            "text": "Search your kitchen cupboards"
          }
        ],
        "onEnter": [
          {
            "type": "textCard",
            "title": "Day 23",
            "body": "{city}. The power went out on day nine and the phones before that. You've been barricaded in the apartment above the transit depot for two weeks.\n\nThis morning you ate the last can of peaches.\n\nYour sister {jo_short} was working at St. Agnes Hospital when the city fell. You haven't heard from her since day one.\n\nTime to go out."
          }
        ]
      },
      {
        "id": "eat",
        "text": "Teodor across the hall left in a hurry. He might have left food behind.",
        "objectives": [
          {
            "id": "eat",
            "type": "use",
            "target": "cat:food",
            "text": "Find food and eat something (Tab)"
          }
        ],
        "onEnter": [
          {
            "type": "hint",
            "hintId": "search"
          }
        ]
      },
      {
        "id": "leave",
        "text": "Get out of the building. Something is moving in the stairwell.",
        "objectives": [
          {
            "id": "kill",
            "type": "kill",
            "target": "walker",
            "text": "Deal with the walker in the stairwell",
            "zoneId": "maple_court"
          },
          {
            "id": "street",
            "type": "reach",
            "target": "maple_court:mc_street",
            "text": "Get out onto Depot Street"
          }
        ],
        "onEnter": [
          {
            "type": "pan",
            "objectId": "mc_stair_walker",
            "seconds": 2.4,
            "caption": "Something is moving in the stairwell."
          }
        ]
      },
      {
        "id": "depot",
        "text": "The transit depot across Depot Street has a workbench. Get there without drawing the whole street.",
        "objectives": [
          {
            "id": "depot",
            "type": "reach",
            "target": "maple_court:mc_depot",
            "text": "Reach the transit depot garage"
          }
        ],
        "onEnter": [
          {
            "type": "hint",
            "hintId": "bottle"
          }
        ]
      },
      {
        "id": "weapon",
        "text": "Marco's break-room doodle showed a nail bat. Build one at the depot workbench.",
        "objectives": [
          {
            "id": "craft",
            "type": "collect",
            "target": "nail_bat",
            "text": "Build a nail bat (depot office workbench)"
          }
        ],
        "onEnter": [
          {
            "type": "hint",
            "hintId": "craft"
          }
        ]
      },
      {
        "id": "firehouse",
        "text": "Teodor said Firehouse 9 on Alder Street has water and a fence. Leave by the east end of Depot Street.",
        "objectives": [
          {
            "id": "reach",
            "type": "reach",
            "target": "firehouse9",
            "text": "Reach Firehouse 9"
          }
        ],
        "onEnter": [
          {
            "type": "unlockNode",
            "nodeId": "firehouse9"
          },
          {
            "type": "hint",
            "hintId": "worldmap"
          }
        ]
      }
    ],
    "outcomes": {},
    "rewards": [
      {
        "type": "xp",
        "amount": 100
      },
      {
        "type": "startQuest",
        "questId": "act1"
      }
    ]
  },
  {
    "id": "act1",
    "name": "Firehouse 9",
    "type": "main",
    "giver": "ruth",
    "description": "Ruth's deal: get the dead ambulance running and you can use it. St. Agnes, and maybe Jo, is too far to walk.",
    "stages": [
      {
        "id": "talk_ruth",
        "text": "Find whoever runs this camp.",
        "objectives": [
          {
            "id": "talk",
            "type": "talk",
            "target": "ruth",
            "text": "Talk to Ruth"
          }
        ]
      },
      {
        "id": "deal",
        "text": "Hear Ruth out.",
        "objectives": [
          {
            "id": "deal",
            "type": "flag",
            "target": "act1_deal",
            "text": "Hear Ruth's deal"
          }
        ]
      },
      {
        "id": "parts",
        "text": "The ambulance needs a battery and fuel.",
        "objectives": [
          {
            "id": "battery",
            "type": "collect",
            "target": "car_battery",
            "text": "Get a car battery from Kessler Auto (the garage is chained)"
          },
          {
            "id": "fuel",
            "type": "collect",
            "target": "fuel_can",
            "text": "Siphon fuel on the Route 17 overpass (2 cans)",
            "count": 2
          }
        ],
        "onEnter": [
          {
            "type": "unlockNode",
            "nodeId": "kessler_auto"
          },
          {
            "type": "unlockNode",
            "nodeId": "route17"
          },
          {
            "type": "unlockRecipe",
            "recipeId": "siphon_hose"
          },
          {
            "type": "hint",
            "hintId": "worldmap"
          }
        ]
      },
      {
        "id": "repair",
        "text": "Bring the battery and fuel to the ambulance in the bay.",
        "objectives": [
          {
            "id": "repair",
            "type": "interact",
            "target": "ambulance",
            "text": "Repair the ambulance"
          }
        ]
      },
      {
        "id": "drive",
        "text": "St. Agnes is too far to walk, but not too far to drive.",
        "objectives": [
          {
            "id": "reach",
            "type": "reach",
            "target": "st_agnes",
            "text": "Drive to St. Agnes Hospital"
          }
        ],
        "onEnter": [
          {
            "type": "unlockNode",
            "nodeId": "st_agnes"
          }
        ]
      },
      {
        "id": "basement",
        "text": "Doc said the bitten were moved to the basement isolation ward. Staff keycards only.",
        "objectives": [
          {
            "id": "down",
            "type": "reach",
            "target": "st_agnes_basement",
            "text": "Get into the basement isolation ward"
          }
        ]
      },
      {
        "id": "boss",
        "text": "Something huge is down here with you.",
        "objectives": [
          {
            "id": "boss",
            "type": "kill",
            "target": "bloater_boss",
            "text": "Kill the thing in the isolation ward"
          }
        ]
      },
      {
        "id": "message",
        "text": "Search the isolation ward for any sign of Jo.",
        "objectives": [
          {
            "id": "rec",
            "type": "collect",
            "target": "jo_recorder",
            "text": "Find Jo's trace"
          }
        ]
      },
      {
        "id": "return",
        "text": "Tell Ruth what you found.",
        "objectives": [
          {
            "id": "tell",
            "type": "talk",
            "target": "ruth",
            "text": "Tell Ruth"
          }
        ],
        "manualAdvance": true
      }
    ],
    "outcomes": {},
    "rewards": [
      {
        "type": "xp",
        "amount": 300
      },
      {
        "type": "setFlag",
        "key": "act1_done",
        "value": true
      },
      {
        "type": "unlockNode",
        "nodeId": "northgate_bridge"
      },
      {
        "type": "textCard",
        "title": "To be continued",
        "body": "Jo is alive, or was, and she is headed for the train at Northgate.\n\nBetween you and her: a river, a bridge, and the Tollmen.\n\nAct 2 — the crossing — is coming in a later version. Until then, Harrow City is yours to scavenge."
      }
    ]
  },
  {
    "id": "medicine_run",
    "name": "Medicine Run",
    "type": "side",
    "giver": "doc_ama",
    "description": "Doc Ama needs antibiotics. The Westside pharmacy locked its controlled stock in a back room.",
    "stages": [
