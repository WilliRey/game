  {
    "id": "missing_scout",
    "name": "The Missing Scout",
    "type": "side",
    "giver": "vera",
    "description": "Pike went scouting at the Gas-N-Go under the Route 17 overpass and never came back.",
    "stages": [
      {
        "id": "find",
        "text": "Find Pike at the Gas-N-Go.",
        "objectives": [
          {
            "id": "find",
            "type": "flag",
            "target": "pike_fate_decided",
            "text": "Find Pike at the Gas-N-Go (Route 17)"
          }
        ],
        "onEnter": [
          {
            "type": "unlockNode",
            "nodeId": "route17"
          }
        ],
        "marker": {
          "zoneId": "route17",
          "objectId": "r17_pike"
        }
      },
      {
        "id": "report",
        "text": "Tell Vera what happened to Pike.",
        "objectives": [
          {
            "id": "tell",
            "type": "talk",
