{
  "name": "holdout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOLDOUT: a zombie survival RPG for desktop browsers, seen from a 3D angled camera.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content"
  },
  "dependencies": {
    "preact": "10.29.8",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
